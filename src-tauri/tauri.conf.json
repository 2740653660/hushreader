{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "hushreader-capability-check",
  "version": "0.1.0",
  "identifier": "com.hushreader.capcheck",
  "build": {
    "frontendDist": "../capability-check",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "隐阅盒能力验证",
        "width": 430,
        "height": 620,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
