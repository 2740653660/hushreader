{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HushReader",
  "version": "0.1.1",
  "identifier": "com.hushreader.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "隐阅盒",
        "width": 960,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/sonovel": "sonovel"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwNTEyNzNEM0REM0Y2NjAKUldSZzl0TTlQU2RSTUE3K0VaTFdORzhRYnJjU3o5Z2lraFVDSGp3U1FsVlp3K3pQR1hvckJSS3UK",
      "endpoints": [
        "https://github.com/2740653660/hushreader/releases/latest/download/latest.json"
      ]
    }
  }
}
